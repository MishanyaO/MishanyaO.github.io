---
import '@fontsource-variable/source-serif-4';
import '../../styles/post.css';
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
import { giscus } from '../../config';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const commentsOn = Boolean(giscus.repoId && giscus.categoryId);
---
<Base title={`${post.data.title} | Mike Olianenko`} description={post.data.summary} type="article">
  <div slot="after-header" class="progress" aria-hidden="true"><i></i></div>

  <div class="post-top">
    <a class="back" href="/#writing">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>All writing</a>

    <div class="post-head">
      <span class="chip">{post.data.tag}</span>
      <h1>{post.data.title}</h1>
      <div class="byline-row">
        <div class="by">
          <span class="avatar" aria-hidden="true">MO</span>
          <span class="t"><strong>Mike Olianenko</strong> · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post.body)}</span>
        </div>
        <div class="sizes">
          <span class="lbl">Text size</span>
          <button type="button" id="size-down" aria-label="A− Smaller text">A−</button>
          <button type="button" id="size-up" aria-label="A+ Larger text">A+</button>
        </div>
      </div>
    </div>

    {post.data.takeaways && post.data.takeaways.length > 0 && (
      <div class="tldr">
        <h2>In short</h2>
        <ul>{post.data.takeaways.map((t) => <li>{t}</li>)}</ul>
      </div>
    )}

    <div class="post-row">
      <nav class="toc" aria-label="On this page">
        <h2 class="label">On this page</h2>
        <div>
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          {commentsOn && <a href="#comments">Comments</a>}
        </div>
      </nav>

      <div class="post-col">
        <article class="prose" id="post-body"><Content /></article>

        {commentsOn && (
          <section id="comments" class="comments"
            data-repo={giscus.repo} data-repo-id={giscus.repoId}
            data-category={giscus.category} data-category-id={giscus.categoryId}
            data-mapping={giscus.mapping}>
            <h2>Comments</h2>
            <div id="giscus-host"></div>
          </section>
        )}

        {(newer || older) && (
          <nav class="more-writing" aria-label="More writing">
            {older && (<a href={`/writing/${older.id}/`}><span class="label">Previous</span><span class="ttl">{older.data.title}</span></a>)}
            {newer && (<a href={`/writing/${newer.id}/`}><span class="label">Next</span><span class="ttl">{newer.data.title}</span></a>)}
          </nav>
        )}

        <div class="author">
          <span class="avatar big" aria-hidden="true">MO</span>
          <div class="txt">
            <div class="nm">Mike Olianenko</div>
            <div class="ds">Product Engineer in Melbourne. <a href="https://www.linkedin.com/in/mikhail-olianenko/">Find me on LinkedIn</a></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="post-end"></div>

  <script is:inline>
    (function () {
      var d = document.documentElement;
      var dec = document.getElementById('size-down');
      var inc = document.getElementById('size-up');
      function get() { var s = d.getAttribute('data-size'); return s === '-1' ? -1 : s === '1' ? 1 : 0; }
      function update() { dec.disabled = get() === -1; inc.disabled = get() === 1; }
      function set(n) {
        n = Math.max(-1, Math.min(1, n));
        if (n === 0) d.removeAttribute('data-size'); else d.setAttribute('data-size', String(n));
        try { localStorage.setItem('textStep', String(n)); } catch (e) {}
        update();
      }
      dec.addEventListener('click', function () { set(get() - 1); });
      inc.addEventListener('click', function () { set(get() + 1); });
      update();

      var links = document.querySelectorAll('.toc a');
      var map = {};
      links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
      if ('IntersectionObserver' in window) {
        var targets = [];
        links.forEach(function (a) { var t = document.getElementById(a.getAttribute('href').slice(1)); if (t) targets.push(t); });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              links.forEach(function (a) { a.removeAttribute('aria-current'); });
              map[e.target.id].setAttribute('aria-current', 'true');
            }
          });
        }, { rootMargin: '0px 0px -70% 0px' });
        targets.forEach(function (t) { io.observe(t); });
      }

      var c = document.getElementById('comments');
      if (c) {
        var loaded = false;
        var theme = function () { return d.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'; };
        var load = function () {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.src = 'https://giscus.app/client.js';
          s.async = true; s.crossOrigin = 'anonymous';
          var a = { 'data-repo': c.dataset.repo, 'data-repo-id': c.dataset.repoId, 'data-category': c.dataset.category,
            'data-category-id': c.dataset.categoryId, 'data-mapping': c.dataset.mapping, 'data-strict': '0',
            'data-reactions-enabled': '1', 'data-emit-metadata': '0', 'data-input-position': 'top',
            'data-theme': theme(), 'data-lang': 'en', 'data-loading': 'lazy' };
          for (var k in a) s.setAttribute(k, a[k]);
          document.getElementById('giscus-host').appendChild(s);
        };
        if ('IntersectionObserver' in window) {
          var o = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { o.disconnect(); load(); } }, { rootMargin: '400px' });
          o.observe(c);
        } else { load(); }
        window.addEventListener('themechange', function () {
          var f = document.querySelector('iframe.giscus-frame');
          if (f && f.contentWindow) f.contentWindow.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
        });
      }
    })();
  </script>
</Base>
