---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../config';
import { getPosts, shortDate, readingMinutes } from '../lib/posts';

const posts = await getPosts();
const fmt = (n: number, dec = 0) =>
  n.toLocaleString('en-AU', { minimumFractionDigits: dec, maximumFractionDigits: dec });
---
<SiteLayout variant="home">
  <main id="top" tabindex="-1">
    <section class="hero rel">
      <div class="hero-main">
        <div class="who" data-rise>
          <img src="/photo.jpg" alt="Mike Olianenko" width="44" height="44" />
          <div class="mono">Mike Olianenko<br />Product Engineer · since 2022</div>
        </div>
        <div class="who-m">
          <img src="/photo.jpg" alt="Mike Olianenko" width="64" height="64" />
          <div><b>Mike Olianenko</b><span class="mono">Product Engineer · Melbourne</span><span class="mono status">● open to chat</span></div>
        </div>
        <h1 class="title" data-rise style="--d:100ms">I build construction software end to end, <span class="hl">and write about building it with agents.</span></h1>
        <div class="contacts mono">
          <a href={site.linkedin}>LinkedIn <span class="arr">↗</span></a>
          <a href={site.github}>GitHub <span class="arr">↗</span></a>
        </div>
      </div>
      <aside class="panel" data-rise style="--d:200ms" aria-label="Stack and links">
        <div class="label mono">Stack</div>
        <ul class="stack mono">
          <li><span class="k lang">lang</span><span class="v">TypeScript</span></li>
          <li><span class="k ui">ui</span><span class="v">React · MUI · Storybook</span></li>
          <li><span class="k infra">infra</span><span class="v">AWS · Postgres</span></li>
          <li><span class="k test">test</span><span class="v">Playwright · Jest</span></li>
        </ul>
        <div class="links mono">
          <a href={site.linkedin}>LinkedIn<span class="arr">↗</span></a>
          <a href={site.github}>GitHub<span class="arr">↗</span></a>
        </div>
      </aside>
    </section>

    <section class="writing" id="writing" aria-labelledby="writing-h">
      <div class="wlabel mono"><span id="writing-h">WRITING</span><span>{posts.length}</span></div>
      <div class="thead mono" aria-hidden="true"><span>DATE</span><span>ESSAY</span><span>TOPIC</span><span class="r">RESULT</span><span class="r">READ</span></div>

      {posts.length === 0 && <p class="more mono">Longer pieces coming.</p>}

      {posts.map((p, i) => {
        const r = p.data.result;
        const mins = readingMinutes(p.body);
        return (
          <a class="post" href={`/writing/${p.id}/`} data-rise style={`--d:${300 + i * 80}ms`}>
            <span class="meta mono">
              <span class="date">{shortDate(p.data.date)}<span class="m-only"> · {mins} min</span></span>
              {r && <span class="res">{r.arrow ?? ''} <span data-count={r.count} data-dec={r.decimals}>{fmt(r.count, r.decimals)}</span>{r.suffix}</span>}
            </span>
            <span class="ttl">{p.data.title}</span>
            <span class="topic mono">{p.data.shortTag ?? p.data.tag}</span>
            <span class="min d mono">{mins} min</span>
            <span class="read mono">Read</span>
          </a>
        );
      })}

    </section>
  </main>
</SiteLayout>
